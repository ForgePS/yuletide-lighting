NEXT_PUBLIC_FIREBASE_API_KEY=AIzaSyD9jk7wARDfxpaYxigLKTJ13gK7eCBhCEY
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=yuletide-lighting.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=yuletide-lighting
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=yuletide-lighting.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=928287362183
NEXT_PUBLIC_FIREBASE_APP_ID=1:928287362183:web:e0cca4d6e2f6d89cc3bc22

# Firebase Admin (server) — required for local sign-in / tRPC.
# Pick ONE of these:
#
# A) Path to the downloaded JSON file (easiest):
# FIREBASE_SERVICE_ACCOUNT_PATH=C:\Users\jerem\Downloads\yuletide-lighting-firebase-adminsdk.json
#
# B) Paste the JSON as a single line:
# FIREBASE_SERVICE_ACCOUNT_KEY={"type":"service_account",...}
FIREBASE_SERVICE_ACCOUNT_KEY=
FIREBASE_SERVICE_ACCOUNT_PATH=
# Optional explicit deploy key (same JSON); overrides FIREBASE_SERVICE_ACCOUNT_KEY when set.
CLCRM_FIREBASE_ADMIN_KEY=
# C) Or use gcloud: `gcloud auth application-default login` then set:
# FIREBASE_USE_ADC=1
FIREBASE_USE_ADC=

# Legacy Postgres (optional â€” Firestore is primary)
DATABASE_URL=

# Stripe (platform) — https://dashboard.stripe.com/apikeys
# Use sk_test_… / pk_test_… for staging; sk_live_… only with PORTAL_ALLOW_LIVE_PAYMENTS=1
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_PRICE_ID_MONTHLY=
STRIPE_PRICE_ID_YEARLY=
# YL-S26: required for sk_live portal checkout (Connect still needs org onboarding)
PORTAL_ALLOW_LIVE_PAYMENTS=
# Optional: force mock AR close even with keys (emulator / incident)
PORTAL_PAYMENT_SAFE_MODE=

# Resend Email
RESEND_API_KEY=
RESEND_FROM_EMAIL=notifications@yourdomain.com

# Twilio SMS
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# Mapbox — create a public token at https://account.mapbox.com/access-tokens/
# Use the same pk.ey… token for both vars. Restrict URLs to your app domain in Mapbox.
# Never put a secret Mapbox token in NEXT_PUBLIC_*. Local: empty token shows map-unavailable UI.
# Staging/production: set token when maps are required (or set MAP_FEATURES_REQUIRED=1 to fail deploy checks).
NEXT_PUBLIC_MAPBOX_TOKEN=
MAPBOX_TOKEN=
MAP_FEATURES_REQUIRED=

# Weather — leave empty to keep weather unavailable (no fabricated forecasts)
WEATHER_PROVIDER=
WEATHER_API_KEY=

# AI — leave empty to keep AI actions disabled (no mocked detections)
AI_PROVIDER=
AI_API_KEY=

# Inngest
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=

# Cloudflare Turnstile (optional CMS form spam — spamProtection=turnstile)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Public website → CRM lead routing (operating Yuletide org id)
OPERATING_ORGANIZATION_ID=
NEXT_PUBLIC_OPERATING_ORGANIZATION_ID=

# Staging (optional separate Firebase project: yuletide-lighting-staging)
# Copy `.env.staging.example` → `.env.staging`, then:
#   1. Link billing on the staging project
#   2. Enable Auth + Storage in Firebase console
#   3. Add a web app and paste NEXT_PUBLIC_* values
#   4. npm run deploy:staging
# E2E_BASE_URL=https://yuletide-lighting.web.app

# Creator console — comma-separated platform operator emails and/or Firebase UIDs
# Local tip: leave both empty so every signed-in user can open Creator + Website CMS.
# In production, always set at least one email/UID.
PLATFORM_CREATOR_EMAILS=
PLATFORM_CREATOR_UIDS=

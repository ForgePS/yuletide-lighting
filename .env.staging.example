# Staging Firebase — yuletide-lighting-staging
# Copy to `.env.staging` and fill after linking billing + creating a web app.

NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=yuletide-lighting-staging.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=yuletide-lighting-staging
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=yuletide-lighting-staging.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

FIREBASE_USE_ADC=1
# Or a staging-only service account JSON (never reuse production Admin key against staging):
# CLCRM_FIREBASE_ADMIN_KEY=

NEXT_PUBLIC_APP_URL=https://yuletide-lighting-staging.web.app
STAGING_APP_URL=https://yuletide-lighting-staging.web.app
E2E_BASE_URL=https://yuletide-lighting-staging.web.app

OPERATING_ORGANIZATION_ID=
NEXT_PUBLIC_OPERATING_ORGANIZATION_ID=

PLATFORM_CREATOR_EMAILS=
PLATFORM_CREATOR_UIDS=

# Leave Stripe/Twilio/Resend empty or use test-mode keys only (sk_test_…).
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# Do not set PORTAL_ALLOW_LIVE_PAYMENTS on staging unless intentionally testing live.
PORTAL_ALLOW_LIVE_PAYMENTS=
PORTAL_PAYMENT_SAFE_MODE=1
RESEND_API_KEY=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
